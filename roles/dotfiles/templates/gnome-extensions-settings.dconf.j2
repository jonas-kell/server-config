[dash-to-dock]
background-opacity=0.80000000000000004
border-radius=0
custom-theme-shrink=true
dash-max-icon-size=30
dock-fixed=true
dock-position='BOTTOM'
extend-height=true
floating-margin=0
height-fraction=0.90000000000000002
intellihide=false
isolate-workspaces=false
manualhide=false
multi-monitor=true
running-indicator-style='DEFAULT'
show-trash=false

[dash-to-panel]
animate-appicon-hover=true
animate-appicon-hover-animation-extent={'RIPPLE': 4, 'PLANK': 4, 'SIMPLE': 1}
appicon-margin=0
appicon-padding=4
available-monitors=[0, 1]
dot-position='BOTTOM'
dot-style-focused='METRO'
hotkeys-overlay-combo='TEMPORARILY'
leftbox-padding=-1
multi-monitors=true
panel-anchors='{"0":"MIDDLE","1":"MIDDLE"}'
panel-element-positions='{"0":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"1":[{"element":"showAppsButton","visible":true,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"leftBox","visible":false,"position":"stackedTL"},{"element":"taskbar","visible":true,"position":"stackedTL"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"rightBox","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
panel-lengths='{"0":100,"1":100}'
panel-positions='{"0":"BOTTOM","1":"BOTTOM"}'
panel-sizes='{"0":42,"1":42}'
primary-monitor=0
status-icon-padding=2
stockgs-keep-dash=false
stockgs-keep-top-panel=false
stockgs-panelbtn-click-only=false
trans-use-custom-bg=false
trans-use-custom-opacity=false
tray-padding=-1
window-preview-title-position='TOP'

[extension-list]
button-icon=uint32 1
delete-button=true
hide-disabled=false
unpin-button=false
unpin-list=@as []
url-button=false

[nvidiautil]
icons=true
position=2
refreshrate=1
settingsandsmiconfig=['active', 'inactive', 'active', 'inactive', 'active']

[pop-shell]
tile-by-default=false

[screenshot]
backend='gnome-screenshot'
capture-delay=0
click-action='show-menu'
clipboard-action='set-image-data'
copy-button-action='set-image-data'
effect-rescale=100
enable-indicator=true
shortcut-select-area=['<Shift><Super>s']
shortcut-select-desktop=['<Shift><Super>a']

[vitals]
alphabetize=true
fixed-widths=true
hide-icons=false
hide-zeros=false
hot-sensors=['_memory_usage_', '__temperature_avg__', '_system_load_1m_', '_processor_usage_', '__network-rx_max__']
include-static-info=false
position-in-panel=4
show-battery=false
show-fan=false
show-memory=true
show-network=true
show-processor=true
show-storage=false
show-system=true
show-voltage=false
unit=0
use-higher-precision=false
